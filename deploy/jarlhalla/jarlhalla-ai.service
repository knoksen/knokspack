[Unit]
Description=JarlhallaAI private backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarlhalla-ai
Group=jarlhalla-ai
WorkingDirectory=/opt/jarlhalla-ai
EnvironmentFile=/etc/jarlhalla-ai.env
ExecStart=/opt/jarlhalla-ai/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8787 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jarlhalla-ai

[Install]
WantedBy=multi-user.target
