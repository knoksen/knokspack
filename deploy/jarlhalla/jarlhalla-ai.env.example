# Default provider: openai, anthropic or ollama
JARLHALLA_AI_PROVIDER=openai

# OpenAI provider
JARLHALLA_OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Anthropic / Claude provider
JARLHALLA_ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_TOKENS=8192

# Ollama provider
JARLHALLA_OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# Backward compatibility. Leave blank when using provider-specific model settings.
JARLHALLA_AI_MODEL=
